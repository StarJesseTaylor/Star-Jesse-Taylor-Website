{
  "rewrites": [
    { "source": "/tour", "destination": "/tour.html" },
    { "source": "/letter", "destination": "/letter.html" },
    { "source": "/app", "destination": "/app.html" }
  ],
  "crons": [
    {
      "path": "/api/blue/daily-cron",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/blue/midday-checkin",
      "schedule": "0 19 * * 1-5"
    },
    {
      "path": "/api/health-check",
      "schedule": "0 13 * * *"
    }
  ]
}
